{
  "name": "samnavigator",
  "tags": ["federal", "sam", "table-detail"],
  "template": "table-detail",
  "urls": ["https://samnavigator.com/sam_preview.aspx"],
  "selectors": {
    "ready": "#main_GridView1 tr input[type='hidden']",
    "row": "#main_GridView1 tr",
    "detailLink": "input[type='hidden']",
    "detailReady": "button:has-text('Download All')",
    "docLink": "button:has-text('Download All') >> nth=0"
  },
  "downloadMode": "click",
  "config": {
    "concurrency": 1,
    "minDelayMs": 1000,
    "maxDelayMs": 2000,
    "navigationTimeoutMs": 45000
  }
}
