{
  "name": "scrape-bid-documents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "scraper": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "p-limit": "^7.3.3",
    "p-retry": "^9.0.0",
    "pino": "^10.4.0",
    "playwright": "^1.65.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
