LOG_LEVEL=info
DATA_DIR=data
SESSIONS_DIR=sessions
HEADLESS=true
TRACE=false
FINGERPRINT=true

# Shared fallback credentials for sites that use the same login
SCRAPER_DEFAULT_USER=
SCRAPER_DEFAULT_PASS=

# bidlocker (one-time signup at https://bidlocker.us/Account/Signup, then put credentials here)
BIDLOCKER_USER=
BIDLOCKER_PASS=
# Optional: restrict to some agencies (comma-separated), default is all 12
# BIDLOCKER_AGENCIES=trimet,lanecc
