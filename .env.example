LOG_LEVEL=info
DATA_DIR=data
SESSIONS_DIR=sessions
HEADLESS=true
TRACE=false
FINGERPRINT=true

# Shared fallback credentials for sites that use the same login
SCRAPER_DEFAULT_USER=
SCRAPER_DEFAULT_PASS=

# bidlocker (one-time signup at https://bidlocker.us/Account/Signup, then put credentials here)
BIDLOCKER_USER=
BIDLOCKER_PASS=
# Optional: restricts bidlocker to specific agencies
# BIDLOCKER_AGENCIES=trimet,lanecc

# Optional: required only for sites using template "firecrawl"
FIRECRAWL_API_KEY=
# FIRECRAWL_BASE_URL=https://api.firecrawl.dev
